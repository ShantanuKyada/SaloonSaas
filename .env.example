# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=0
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true

# ─── Database ─────────────────────────────────────────────────────────────
# Runtime role: NOT the table owner, so PostgreSQL row-level security applies to it.
DATABASE_URL=postgres://salon_app:change-me-app@localhost:5432/salon_dev
# Owner role used only for migrations.
DATABASE_MIGRATION_URL=postgres://salon_owner:change-me-owner@localhost:5432/salon_dev
# Only needed for `npm run db:setup` on a local machine.
DATABASE_SUPERUSER_URL=postgres://postgres@localhost:5432/postgres
TEST_DATABASE_URL=postgres://salon_app:change-me-app@localhost:5432/salon_test
TEST_DATABASE_MIGRATION_URL=postgres://salon_owner:change-me-owner@localhost:5432/salon_test
DB_APP_ROLE=salon_app
DB_POOL_MAX=10
DB_SSL=false

# ─── Security ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
PUBLIC_LINK_SECRET=replace-with-another-long-random-string-32-chars-min
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Required in production; Prometheus scrapes /metrics with "Authorization: Bearer <token>"
METRICS_TOKEN=

# ─── Notifications ────────────────────────────────────────────────────────
# console = log messages instead of sending (development only); live = use providers below
NOTIFICATIONS_MODE=console
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
EMAIL_API_KEY=
EMAIL_FROM="Salon <no-reply@example.com>"
SMS_PROVIDER=none
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ─── Attendance (default biometric HTTP provider; per-branch devices are configured in the app) ──
BIOMETRIC_API_URL=
BIOMETRIC_API_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=25
WORKER_CONCURRENCY=5

# ─── Web (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ─── Testing ──────────────────────────────────────────────────────────────
# Multiplies every rate limit. Use only for end-to-end or load tests; must be 1 in production.
# RATE_LIMIT_MULTIPLIER=50

{
  "name": "@salon/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@salon/source --env-file-if-exists=../../.env src/server.ts",
    "worker:dev": "tsx watch --conditions=@salon/source --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/db/setup.ts",
    "db:migrate": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/seed/seed.ts",
    "db:reset": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/db/reset.ts",
    "db:codegen": "kysely-codegen --env-file ../../.env --url env(DATABASE_MIGRATION_URL) --camel-case --date-parser string --exclude-pattern schema_migrations --out-file src/db/schema.generated.ts && node scripts/patch-codegen.mjs",
    "platform:admin": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/seed/create-platform-admin.ts",
    "user:reset-2fa": "tsx --conditions=@salon/source --env-file-if-exists=../../.env src/seed/reset-two-factor.ts",
    "db:erd": "node --env-file-if-exists=../../.env scripts/generate-erd.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@salon/shared": "1.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "kysely": "0.28.18",
    "luxon": "3.7.2",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "10.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "kysely-codegen": "0.18.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}

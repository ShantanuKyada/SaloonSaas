# Copy to deploy/.env and fill in every value. Never commit the real file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Public address customers and staff use (https, no trailing slash). Also the only allowed browser origin.
PUBLIC_URL=https://salon.example.com
HTTP_PORT=8080
# Proxy hops between the internet and the API: web container (1) + your TLS proxy / load balancer (1) = 2.
TRUST_PROXY=2
TAG=latest
LOG_LEVEL=info

# PostgreSQL. Three different passwords: the server superuser, the migration (owner) role and the runtime role.
POSTGRES_PASSWORD=
DB_NAME=salon
DB_OWNER_USER=salon_owner
DB_OWNER_PASSWORD=
DB_APP_USER=salon_app
DB_APP_PASSWORD=
DB_HOST=db
DB_SSL=false

# Secrets: at least 32 characters each; the encryption key is 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_ACCESS_SECRET=
PUBLIC_LINK_SECRET=
DATA_ENCRYPTION_KEY=
# Bearer token Prometheus uses to scrape /metrics (at least 16 characters)
METRICS_TOKEN=

# Messaging: live sends through the connections each salon sets up in Settings → Connections.
NOTIFICATIONS_MODE=live
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
